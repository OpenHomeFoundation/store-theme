{%- comment -%}
  "Spotted in the community" (redesign 2026): a slowly drifting strip of tilted photo prints of people wearing the merch,
  with "where it was taken" captions and pins that open a small product card.
  - Photos come from Community photo entries (Content › Metaobjects, type community_photo; decision h05), then from
    this section's own Photo blocks (handy before the entries exist, or for one-offs).
  - New random order on every visit; each print keeps the tilt of its slot.
  - Motion (assets in the script below): drifts on its own, pauses while the mouse is over it or a product card is
    open, follows swipes, trackpads and mouse drags with momentum, and loops seamlessly (the set is cloned once,
    hidden from screen readers). Reduced motion: no drift and no clone; it's a normal scrolling row.
  - Mouse: hovering a print straightens it, shows its caption and the product card for the pin nearest the pointer.
    Touch and keyboard: tap/press a pin to open its card.
{%- endcomment -%}
{%- liquid
  assign entries = shop.metaobjects.community_photo.values
  assign block_photos = section.blocks | where: 'type', 'photo'
  assign total = entries.size | plus: block_photos.size
-%}

{%- if total > 0 -%}
  <section class="ohf-community" aria-labelledby="OhfCommunityTitle-{{ section.id }}">
    <div class="ohf-wrap ohf-community__head">
      <div>
        {%- if section.settings.kicker != blank -%}
          <p class="ohf-kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        <h2 id="OhfCommunityTitle-{{ section.id }}" class="ohf-title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <p class="ohf-community__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <ohf-strip class="ohf-strip" role="region" aria-label="{{ section.settings.heading | escape }}">
      <div class="ohf-strip__track" data-strip-track>
        <div class="ohf-strip__set" data-strip-set>
          {%- for entry in entries -%}
            {%- if entry.photo.value != blank -%}
              {%- render 'ohf-polaroid',
                image: entry.photo.value,
                alt: entry.description.value,
                place: entry.place.value,
                event: entry.event.value,
                products: entry.products.value,
                pins: entry.pins.value,
                key: entry.system.handle
              -%}
            {%- endif -%}
          {%- endfor -%}
          {%- for block in block_photos -%}
            {%- if block.settings.image != blank -%}
              {%- render 'ohf-polaroid',
                image: block.settings.image,
                alt: block.settings.alt,
                place: block.settings.place,
                event: block.settings.event,
                products: block.settings.products,
                pins: block.settings.pins,
                key: block.id
              -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </ohf-strip>
  </section>
{%- elsif request.design_mode -%}
  <div class="ohf-wrap ohf-community__empty">
    <p>
      <strong>Spotted in the community:</strong> no photos yet. Add Community photo entries in Content › Metaobjects,
      or add Photo blocks to this section. This message only shows in the theme editor.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .ohf-community {
    padding-block: 144px;
    background: #e5dac8;
    overflow: hidden;
  }
  :root[data-lights='off'] .ohf-community {
    background: color-mix(in srgb, var(--ohf-light-grey) 6%, var(--ohf-dark-blue));
  }
  .ohf-community__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s40);
    align-items: end;
    margin-bottom: 56px;
  }
  .ohf-community__head .ohf-kicker {
    margin: 0 0 var(--s8);
  }
  .ohf-community__text {
    margin: 0;
    font-size: 1.6rem;
    color: var(--heading);
  }
  .ohf-community__empty {
    padding-block: 48px;
    color: var(--body);
  }

  /* The strip: a real horizontal scroller with room above and below for tilted prints and product cards */
  .ohf-strip {
    display: block;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 32px 0 140px;
    margin-bottom: -100px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    cursor: grab;
  }
  .ohf-strip::-webkit-scrollbar {
    display: none;
  }
  .ohf-strip.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .ohf-strip.is-dragging a {
    pointer-events: none;
  }
  .ohf-strip__track {
    display: flex;
    width: max-content;
  }
  .ohf-strip__set {
    display: flex;
    align-items: center;
    gap: var(--s24);
    padding-left: var(--s24);
  }
  @media (prefers-reduced-motion: reduce) {
    .ohf-strip__set[aria-hidden] {
      display: none;
    }
  }

  /* A print */
  .ohf-print {
    --h: 300px;
    position: relative;
    flex: 0 0 auto;
    width: calc(var(--h) * var(--ar, 1.333) + 16px);
    max-width: min(80vw, 560px); /* very wide photos are cropped rather than dominating the strip */
    margin: 0;
    padding: 8px;
    border-radius: var(--r-xs);
    background: var(--ohf-light-grey);
    box-shadow: 0 34px 90px -28px rgba(9, 32, 46, 0.6);
    rotate: var(--r, 0deg);
    translate: 0 var(--dy, 0px);
    transition: rotate var(--dur-in) var(--ease), translate var(--dur-in) var(--ease), scale var(--dur-in) var(--ease);
  }
  .ohf-print__img {
    display: block;
    width: 100%;
    height: var(--h);
    object-fit: cover;
    border-radius: var(--r-xs);
    background: var(--privacy-main);
    user-select: none;
    -webkit-user-drag: none;
  }
  .ohf-print.is-peek {
    z-index: 6;
    rotate: 0deg;
    translate: 0 calc(var(--dy, 0px) - 8px);
    scale: 1.03;
  }
  .ohf-print:has(.ohf-spot__dot[aria-expanded='true']) {
    z-index: 5;
  }

  .ohf-print__where {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    display: flex;
    align-items: flex-start;
    gap: 6px;
    padding: 28px 12px 10px;
    border-radius: 0 0 var(--r-xs) var(--r-xs);
    background: linear-gradient(to top, rgba(9, 32, 46, 0.85), transparent);
    color: var(--ohf-light-grey);
    font: 400 1.2rem/1.35 var(--font-body-family);
    pointer-events: none;
    opacity: 0;
    translate: 0 4px;
    transition: opacity var(--dur-ui) var(--ease), translate var(--dur-ui) var(--ease);
  }
  .ohf-print__where svg {
    flex: none;
    margin-top: 1px;
  }
  .ohf-print__where span {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ohf-print__where strong {
    font-family: var(--font-heading-family);
    font-weight: 600;
  }
  .ohf-print.is-peek .ohf-print__where {
    opacity: 1;
    translate: 0 0;
  }
  @media (hover: none) {
    .ohf-print__where {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* Pins and their product cards */
  .ohf-spot {
    position: absolute;
    left: var(--sx);
    top: var(--sy);
    z-index: 3;
  }
  .ohf-spot__dot {
    position: relative;
    width: 12px;
    height: 12px;
    padding: 0;
    translate: -50% -50%;
    border: 2px solid var(--ohf-light-grey);
    border-radius: 50%;
    background: var(--ohf-light-blue);
    cursor: pointer;
  }
  .ohf-spot__dot::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
  }
  .ohf-spot__dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    border: 2px solid var(--ohf-light-grey);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    animation: ohf-spot-pulse 2.8s var(--ease) infinite;
    animation-delay: var(--pd, 0s);
  }
  .ohf-spot__dot[aria-expanded='true'] {
    background: var(--ohf-dark-blue);
  }
  .ohf-spot__dot[aria-expanded='true']::before {
    animation: none;
  }
  @keyframes ohf-spot-pulse {
    0% {
      opacity: 0.8;
      scale: 1;
    }
    60%,
    to {
      opacity: 0;
      scale: 2.2;
    }
  }
  .ohf-small-card {
    position: absolute;
    left: 0;
    top: 14px;
    translate: -50% 0;
    width: 300px;
    display: none;
    padding: var(--s8);
    border-radius: var(--r-xs);
    background: var(--ohf-light-grey);
    box-shadow: 0 12px 40px rgba(9, 32, 46, 0.25);
  }
  .ohf-spot--up .ohf-small-card {
    top: auto;
    bottom: 14px;
  }
  .ohf-spot__dot[aria-expanded='true'] + .ohf-small-card,
  .ohf-print.is-peek .ohf-spot.is-active .ohf-small-card {
    display: flex;
    animation: ohf-small-card-in var(--dur-ui) var(--ease);
  }
  .ohf-print.is-peek .ohf-spot.is-active {
    z-index: 4;
  }
  @keyframes ohf-small-card-in {
    from {
      opacity: 0;
      translate: -50% 10px;
    }
    to {
      opacity: 1;
      translate: -50% 0;
    }
  }
  .ohf-small-card__body {
    display: flex;
    align-items: center;
    gap: var(--s12);
    color: inherit;
    text-decoration: none;
  }
  .ohf-small-card img {
    flex: none;
    width: 78px;
    height: 78px;
    object-fit: cover;
    border-radius: var(--r-xs);
    background: #fff;
  }
  .ohf-small-card__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ohf-small-card__name {
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ohf-dark-blue);
  }
  .ohf-small-card__link {
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
    color: var(--ohf-dark-grey);
    text-decoration: underline;
  }
  :root[data-lights='off'] .ohf-small-card {
    background: var(--ohf-dark-blue);
  }
  :root[data-lights='off'] .ohf-small-card__name {
    color: var(--ohf-light-grey);
  }
  :root[data-lights='off'] .ohf-small-card__link {
    color: var(--ohf-grey);
  }
  :root[data-lights='off'] .ohf-spot__dot[aria-expanded='true'] {
    background: var(--ohf-light-blue);
  }

  @media (max-width: 900px) {
    .ohf-community__head {
      grid-template-columns: 1fr;
      gap: var(--s16);
    }
  }
  @media (max-width: 640px) {
    .ohf-community {
      padding-block: 96px;
    }
    .ohf-print {
      --h: 240px !important;
    }
    .ohf-small-card {
      width: 240px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ohf-print,
    .ohf-print__where {
      transition: none;
    }
    .ohf-spot__dot::before {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('ohf-strip')) {
    customElements.define(
      'ohf-strip',
      class OhfStrip extends HTMLElement {
        // Tilt, vertical offset and height per slot, from the concept's strip (portrait prints get taller)
        static SLOTS = [
          [-4.3, 6, 300],
          [1.8, -4, 280],
          [2.5, 7, 300],
          [-2.2, 1, 260],
          [3.9, 8, 320],
          [-1.6, -3, 300],
          [-3.4, 5, 290],
          [2.2, -6, 290],
          [-2.6, 4, 300],
          [3.1, -2, 270],
          [-1.4, 7, 300],
          [2.8, 0, 260],
        ];

        connectedCallback() {
          this.set = this.querySelector('[data-strip-set]');
          if (!this.set) return;
          this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
          this.fine = window.matchMedia('(hover: hover) and (pointer: fine)');
          this.arrange();
          this.cloneSet();
          this.bindPins();
          if (this.fine.matches) this.bindPeek();
          this.bindMotion();
        }

        disconnectedCallback() {
          cancelAnimationFrame(this.raf);
          window.removeEventListener('pointermove', this.onPointerMove);
          window.removeEventListener('pointerup', this.onPointerUp);
          document.removeEventListener('click', this.onDocClick);
        }

        // New random order on every visit; each print takes the tilt of the slot it lands in
        arrange() {
          const prints = [...this.set.children];
          for (let i = prints.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [prints[i], prints[j]] = [prints[j], prints[i]];
          }
          prints.forEach((p, i) => {
            const [r, dy, h] = OhfStrip.SLOTS[i % OhfStrip.SLOTS.length];
            const portrait = parseFloat(getComputedStyle(p).getPropertyValue('--ar')) < 1;
            p.style.setProperty('--r', `${r}deg`);
            p.style.setProperty('--dy', `${dy}px`);
            p.style.setProperty('--h', `${portrait ? h + 40 : h}px`);
          });
          this.set.append(...prints);
        }

        // A second copy of the set makes the loop seamless; it's hidden from screen readers and the tab order
        cloneSet() {
          if (this.reduce.matches || this.set.children.length < 2) return;
          const copy = this.set.cloneNode(true);
          copy.setAttribute('aria-hidden', 'true');
          copy.removeAttribute('data-strip-set');
          copy.querySelectorAll('a, button').forEach((el) => (el.tabIndex = -1));
          copy.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
          copy.querySelectorAll('[aria-controls]').forEach((el) => el.removeAttribute('aria-controls'));
          copy.querySelectorAll('img').forEach((img) => (img.alt = ''));
          this.set.after(copy);
          this.looping = true;
        }

        // Pins: tap or press to open that product's card; one open at a time; outside click or Escape closes
        bindPins() {
          this.closePins = (except) =>
            this.querySelectorAll('[data-spot][aria-expanded="true"]').forEach((b) => {
              if (b !== except) b.setAttribute('aria-expanded', 'false');
            });
          this.addEventListener('click', (e) => {
            const dot = e.target.closest('[data-spot]');
            if (!dot || this.dragged) return;
            const open = dot.getAttribute('aria-expanded') !== 'true';
            this.closePins(dot);
            dot.setAttribute('aria-expanded', String(open));
          });
          this.onDocClick = (e) => {
            if (!e.target.closest('.ohf-spot')) this.closePins();
          };
          document.addEventListener('click', this.onDocClick);
          this.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') this.closePins();
          });
        }

        // Mouse: hovering a print straightens it and shows the card for the pin nearest the pointer
        bindPeek() {
          this.addEventListener('mouseenter', () => (this.hovering = true));
          this.addEventListener('mouseleave', () => (this.hovering = false));
          const nearest = (print, x, y) => {
            const spots = [...print.querySelectorAll('.ohf-spot')];
            let best = null;
            let bestD = Infinity;
            spots.forEach((s) => {
              const r = s.querySelector('.ohf-spot__dot').getBoundingClientRect();
              const d = (r.left + r.width / 2 - x) ** 2 + (r.top + r.height / 2 - y) ** 2;
              if (d < bestD) {
                bestD = d;
                best = s;
              }
            });
            spots.forEach((s) => s.classList.toggle('is-active', s === best));
          };
          this.querySelectorAll('.ohf-print').forEach((p) => {
            p.addEventListener('mouseenter', (e) => {
              if (this.dragged) return;
              p.classList.add('is-peek');
              nearest(p, e.clientX, e.clientY);
            });
            p.addEventListener('mousemove', (e) => {
              if (p.classList.contains('is-peek')) nearest(p, e.clientX, e.clientY);
            });
            p.addEventListener('mouseleave', () => {
              p.classList.remove('is-peek');
              p.querySelectorAll('.ohf-spot.is-active').forEach((s) => s.classList.remove('is-active'));
            });
          });
        }

        // Drift, follow the visitor's own scrolling with momentum, and wrap around seamlessly
        bindMotion() {
          const SPEED = 30; // px per second
          let pos = this.scrollLeft;
          let last = performance.now();
          let userUntil = 0;
          let lastSet = -1;
          let vel = 0;
          let userVel = 0;
          let lastMoveAt = 0;
          let dragX = null;
          let dragStart = 0;
          const setWidth = () => this.set.offsetWidth;

          const userMoved = (delta) => {
            const now = performance.now();
            const gap = Math.max(16, now - lastMoveAt);
            userVel = gap > 120 ? 0 : Math.max(-1500, Math.min(1500, userVel * 0.5 + (delta / gap) * 500));
            lastMoveAt = now;
          };
          const followUser = () => {
            if (lastSet >= 0 && Math.abs(this.scrollLeft - lastSet) > 2) {
              userMoved(this.scrollLeft - lastSet);
              pos = this.scrollLeft;
              lastSet = this.scrollLeft;
              userUntil = performance.now() + 120;
            }
          };
          const tick = (now) => {
            const dt = Math.min(64, now - last);
            last = now;
            followUser();
            const w = setWidth();
            const active = now < userUntil || dragX !== null;
            if (active) {
              vel = userVel;
            } else if (!this.reduce.matches && this.looping) {
              const paused = this.hovering || this.querySelector('[data-spot][aria-expanded="true"]');
              const target = paused ? 0 : SPEED;
              vel += (target - vel) * (1 - Math.exp(-dt / 380));
              pos += (vel * dt) / 1000;
            }
            if (this.looping && w > 0) {
              if (pos >= w) pos -= w;
              if (pos < 1) pos += w;
            }
            if (this.looping && Math.abs(this.scrollLeft - pos) >= 1) {
              this.scrollLeft = pos;
              lastSet = this.scrollLeft;
            } else if (lastSet < 0) {
              lastSet = this.scrollLeft;
            }
            this.raf = requestAnimationFrame(tick);
          };

          this.addEventListener('scroll', followUser, { passive: true });
          this.addEventListener('dragstart', (e) => e.preventDefault());
          this.addEventListener('pointerdown', (e) => {
            if (e.pointerType !== 'mouse' || e.button !== 0 || e.target.closest('.ohf-small-card')) return;
            dragX = e.clientX;
            dragStart = pos;
            this.dragged = false;
          });
          this.onPointerMove = (e) => {
            if (dragX === null) return;
            const dx = e.clientX - dragX;
            if (Math.abs(dx) > 5) {
              this.dragged = true;
              this.classList.add('is-dragging');
            }
            if (this.dragged) {
              userMoved(dragStart - dx - pos);
              pos = dragStart - dx;
              this.scrollLeft = pos;
              lastSet = this.scrollLeft;
              userUntil = performance.now() + 120;
            }
          };
          this.onPointerUp = () => {
            if (dragX !== null && performance.now() - lastMoveAt > 80) userVel = 0;
            dragX = null;
            this.classList.remove('is-dragging');
            setTimeout(() => (this.dragged = false), 0);
          };
          window.addEventListener('pointermove', this.onPointerMove);
          window.addEventListener('pointerup', this.onPointerUp);
          this.raf = requestAnimationFrame(tick);
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "OHF community photos",
  "class": "ohf-community-section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small heading",
      "default": "Community favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spotted in the community"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "At meetups, hackathons, and halfway across the world: we love seeing your support for our projects."
    },
    {
      "type": "paragraph",
      "content": "Photos come from Community photo entries (Content › Metaobjects) first, then from Photo blocks below."
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "alt", "label": "Photo description", "info": "Who and what is in the photo, for screen readers." },
        { "type": "text", "id": "place", "label": "Place", "info": "e.g. Oslo, Norway" },
        { "type": "text", "id": "event", "label": "Event", "info": "e.g. Community Meetup 2026" },
        { "type": "product_list", "id": "products", "label": "Products worn", "limit": 3 },
        {
          "type": "text",
          "id": "pins",
          "label": "Pin positions",
          "info": "Optional: where each product's pin sits, as left,top percentages in the same order as the products, separated by | (e.g. 25,57|50,53). Leave empty to spread them out."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OHF community photos"
    }
  ]
}
{% endschema %}

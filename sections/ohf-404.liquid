{%- comment -%}
  OHF 404 page (redesign 2026): a big "404", a heading, a line of text, a search field and a Shop all button.
  Keeps the Plausible "404" event from the old page (with the missing path), so broken links still show up in
  the analytics dashboard.
{%- endcomment -%}
{{ 'ohf-page.css' | asset_url | stylesheet_tag }}

<div class="ohf-page ohf-404">
  <div class="ohf-wrap">
    <p class="ohf-404__code" aria-hidden="true">404</p>
    <h1 class="ohf-page__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="ohf-page__lede">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    <form action="{{ routes.search_url }}" method="get" role="search" class="ohf-404__search">
      <label class="visually-hidden" for="Ohf404Search">{{ 'general.search.search' | t }}</label>
      <input
        id="Ohf404Search"
        class="ohf-field__input"
        type="search"
        name="q"
        placeholder="{{ section.settings.placeholder | escape }}"
        autocomplete="off"
      >
      <input name="options[prefix]" type="hidden" value="last">
      <button class="ohf-cta ohf-cta--outline" type="submit">{{ 'general.search.search' | t }}</button>
    </form>

    <a href="{{ routes.all_products_collection_url }}" class="ohf-cta ohf-cta--fill">
      <span>{{ section.settings.button_label | escape }}</span>
      {%- render 'ohf-icon', icon: 'arrow-right', size: 18 -%}
    </a>
  </div>
</div>

<script>
  if (window.plausible) plausible('404', { props: { path: document.location.pathname } });
</script>

{% stylesheet %}
  .ohf-404__code {
    margin: 0 0 var(--s16);
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: clamp(9.6rem, 16vw, 22rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ohf-light-blue);
  }
  .ohf-404__search {
    display: flex;
    gap: var(--s12);
    max-width: 560px;
    margin: 40px 0 var(--s24);
  }
  .ohf-404__search .ohf-field__input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 var(--s16);
    border: 1px solid var(--line);
    border-radius: var(--r-xs);
    background: #fff;
    color: var(--ohf-dark-blue);
    font-family: var(--font-body-family);
    font-size: 1.6rem;
  }
  :root[data-lights='off'] .ohf-404__search .ohf-field__input {
    background: color-mix(in srgb, var(--ohf-light-grey) 6%, var(--bg));
    color: var(--heading);
  }
  .ohf-404__search .ohf-field__input:focus-visible {
    outline: 3px solid var(--cta-focus);
    outline-offset: 1px;
  }
  @media (max-width: 640px) {
    .ohf-404__search {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "OHF 404",
  "tag": "section",
  "class": "ohf-404-section",
  "enabled_on": {
    "templates": ["404"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "The page you were looking for doesn’t exist or has moved. Try a search, or have a look around the shop."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search field placeholder",
      "default": "Hoodies, stickers, ESPHome…"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all"
    }
  ]
}
{% endschema %}

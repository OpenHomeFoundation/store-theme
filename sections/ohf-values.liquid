{%- comment -%}
  OHF values (redesign 2026, Why it matters page): up to three big value cards on dark blue that stack like a deck
  as you scroll. The card stage pins in the middle of the screen and each card gets its own stretch of scrolling
  before the next glides in (the second from the right, the third from the left); scrolling back reverses it.
  Steps are triggered, then animated in CSS, not tied frame by frame to the scroll.
  With reduced motion turned on, the cards are simply listed one under another.
  Card artwork: the block's image, else the theme's artwork for the card's colour (assets/ohf-value-*.webp).
{%- endcomment -%}
<ohf-values class="ohf-values" id="ohf-values-{{ section.id }}" data-step="1">
  <div class="ohf-wrap ohf-values__head ohf-reveal">
    {%- if section.settings.kicker != blank -%}
      <p class="ohf-kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    <h2 class="ohf-values__title">{{ section.settings.heading | escape }}</h2>
  </div>
  <div class="ohf-wrap">
    <div class="ohf-values__track" data-track>
      <div class="ohf-values__stage" data-stage>
        {%- for block in section.blocks -%}
          {%- assign colour = block.settings.colour -%}
          <article
            class="ohf-vcard ohf-vcard--{{ colour }}"
            aria-labelledby="OhfVcard-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {%- liquid
              if block.settings.image
                assign art_url = block.settings.image | image_url: width: 1100
              else
                assign art_url = 'ohf-value-' | append: colour | append: '.webp' | asset_url
              endif
            -%}
            <div class="ohf-vcard__bg" aria-hidden="true" style="--vimg: url('{{ art_url }}');">
              {%- if block.settings.image -%}
                {{
                  block.settings.image
                  | image_url: width: 2000
                  | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 1440px) 1360px, 100vw', widths: '750, 1100, 1500, 2000'
                }}
              {%- else -%}
                <img
                  src="{{ 'ohf-value-' | append: colour | append: '.webp' | asset_url }}"
                  alt=""
                  width="2000"
                  height="996"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <div class="ohf-vcard__text">
              {%- if block.settings.label != blank -%}
                <p class="ohf-vcard__label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              <h3 class="ohf-vcard__title" id="OhfVcard-{{ block.id }}">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <div class="ohf-vcard__panel">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</ohf-values>

{% stylesheet %}
  .ohf-values {
    --stage-h: 600px;
    --dwell: 0px;
    --stick-top: 110px;
    display: block;
    padding-block: 144px;
    overflow-x: clip;
    background: var(--ohf-dark-blue);
  }
  .ohf-values__head {
    margin-bottom: 64px;
  }
  .ohf-values .ohf-kicker {
    color: var(--ohf-grey);
  }
  .ohf-values__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(3.2rem, 3.6vw, 5.2rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--ohf-light-grey);
  }
  .ohf-values__track {
    position: relative;
    padding-top: 56px;
    height: calc(56px + var(--stage-h) + 2.5 * var(--dwell));
  }
  .ohf-values__stage {
    position: sticky;
    top: var(--stick-top);
    height: var(--stage-h);
  }
  .ohf-vcard {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 40px;
    border-radius: var(--r-xs);
    color: var(--ohf-dark-blue);
    transform-origin: 50% 0%;
    backface-visibility: hidden;
    transition: translate var(--dur-in) var(--ease), scale var(--dur-in) var(--ease);
  }
  .ohf-vcard:nth-child(1) {
    z-index: 1;
  }
  .ohf-vcard:nth-child(2) {
    z-index: 2;
    translate: 115% 0;
  }
  .ohf-vcard:nth-child(3) {
    z-index: 3;
    translate: -115% 0;
  }
  .ohf-values[data-step='2'] .ohf-vcard:nth-child(2),
  .ohf-values[data-step='3'] .ohf-vcard:nth-child(2),
  .ohf-values[data-step='3'] .ohf-vcard:nth-child(3) {
    translate: 0 0;
  }
  .ohf-values[data-step='2'] .ohf-vcard:nth-child(1),
  .ohf-values[data-step='3'] .ohf-vcard:nth-child(2) {
    translate: 0 -28px;
    scale: 0.95;
  }
  .ohf-values[data-step='3'] .ohf-vcard:nth-child(1) {
    translate: 0 -56px;
    scale: 0.9;
  }
  .ohf-vcard--privacy {
    background: var(--privacy-main);
  }
  .ohf-vcard--choice {
    background: var(--choice-main);
  }
  .ohf-vcard--sustainability {
    background: var(--sustainability-main);
  }
  .ohf-vcard__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .ohf-vcard__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    display: block;
  }
  .ohf-vcard__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s20);
    height: 100%;
  }
  .ohf-vcard__label {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 2.4rem;
    line-height: 1;
  }
  .ohf-vcard__title {
    margin: 0;
    max-width: min(760px, 52%);
    font-family: var(--font-heading-family);
    font-size: clamp(3.6rem, 4.6vw, 7.2rem);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ohf-dark-blue);
    text-wrap: balance;
  }
  .ohf-vcard__panel {
    margin-top: auto;
    max-width: 460px;
    padding: var(--s20);
    border-radius: var(--r-xs);
    background: var(--ohf-light-grey);
    color: var(--ohf-dark-grey);
    font-size: 1.6rem;
    line-height: 1.5;
  }
  .ohf-vcard__panel p {
    margin: 0;
  }
  .ohf-vcard__panel a {
    color: inherit;
  }

  /* Reduced motion (and the theme editor): cards listed one under another */
  .ohf-values--static .ohf-values__track {
    height: auto;
  }
  .ohf-values--static .ohf-values__stage {
    position: relative;
    top: auto;
    height: auto;
    display: flex;
    flex-direction: column;
    gap: var(--s24);
  }
  .ohf-values--static .ohf-vcard {
    position: relative;
    inset: auto;
    min-height: 480px;
    translate: none !important;
    scale: none !important;
  }
  @media (max-width: 900px) {
    .ohf-values {
      padding-block: 96px;
    }
    .ohf-vcard {
      padding: var(--s24);
    }
    .ohf-vcard__title {
      max-width: none;
    }
  }
  /* Phones: the artwork's plain left edge fills the card and the artwork itself sits in the lower part,
     fading in, so the heading stays readable */
  @media (max-width: 640px) {
    .ohf-vcard__bg img {
      object-position: 0% center;
    }
    .ohf-vcard__bg::after {
      content: '';
      position: absolute;
      inset: auto 0 0 0;
      height: 62%;
      background: var(--vimg) 88% center / cover no-repeat;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 35%);
      mask-image: linear-gradient(to bottom, transparent, #000 35%);
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('ohf-values')) {
    customElements.define(
      'ohf-values',
      class extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-track]');
          this.stage = this.querySelector('[data-stage]');
          this.count = this.stage.children.length;
          this.step = 1;
          this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
          // In the theme editor the cards are listed, so each one can be selected and edited
          this.isStatic = () => this.reduce.matches || window.Shopify?.designMode || this.count < 2;

          this.size = () => {
            this.classList.toggle('ohf-values--static', this.isStatic());
            if (this.isStatic()) return;
            const vh = window.innerHeight;
            // Reading pace: each card gets 60% of a screen of scrolling before the next one glides in
            this.dwell = Math.round(vh * 0.6);
            this.stickTop = Math.round(Math.max(110, (vh - this.stage.offsetHeight) / 2 + 28));
            this.style.setProperty('--dwell', `${this.dwell}px`);
            this.style.setProperty('--stick-top', `${this.stickTop}px`);
            this.render();
          };

          this.render = () => {
            this.frame = null;
            if (this.isStatic()) return;
            // How far we've scrolled since the stage pinned, less half a dwell before card 2 arrives
            const a = this.stickTop - (this.track.getBoundingClientRect().top + 56) - this.dwell * 0.5;
            const b = this.dwell;
            let step = this.step;
            // Small hysteresis so a card never flickers at the boundary
            if (a >= 0 && step < 2) step = 2;
            if (a >= b && step < 3) step = 3;
            if (a < b - 40 && step > 2) step = 2;
            if (a < -40 && step > 1) step = 1;
            step = Math.min(step, this.count);
            if (step !== this.step) {
              this.step = step;
              this.dataset.step = String(step);
            }
          };

          this.onScroll = () => {
            if (!this.frame) this.frame = requestAnimationFrame(this.render);
          };
          window.addEventListener('scroll', this.onScroll, { passive: true });
          window.addEventListener('resize', this.size);
          this.size();
        }

        disconnectedCallback() {
          window.removeEventListener('scroll', this.onScroll);
          window.removeEventListener('resize', this.size);
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "OHF values",
  "tag": "section",
  "class": "ohf-values-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small heading",
      "default": "What we stand for"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three things we won’t trade for convenience."
    },
    {
      "type": "paragraph",
      "content": "Up to three value cards. They stack like a deck as visitors scroll (listed one under another in the theme editor and for visitors who turn off motion)."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value card",
      "settings": [
        {
          "type": "select",
          "id": "colour",
          "label": "Colour",
          "default": "privacy",
          "options": [
            { "value": "privacy", "label": "Privacy (blue)" },
            { "value": "choice", "label": "Choice (orange)" },
            { "value": "sustainability", "label": "Sustainability (green)" }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Privacy"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Control your personal data."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>You decide what to share and who sees it. Devices must work locally, with the cloud strictly opt-in.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background artwork",
          "info": "Optional. Leave empty to use the theme's artwork for the card's colour. Wide (about 2:1), artwork on the right."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OHF values",
      "blocks": [
        { "type": "value" },
        {
          "type": "value",
          "settings": {
            "colour": "choice",
            "label": "Choice",
            "title": "Mix and match your devices.",
            "text": "<p>Devices should be interoperable by design, with open standards and no vendor lock-in.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "colour": "sustainability",
            "label": "Sustainability",
            "title": "Keep your gear going.",
            "text": "<p>Hardware should be built to last and stay useful for years, not until a server shuts down.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  OHF search results page (redesign 2026). The concept has no design for it, so it reuses the Shop page's look:
  the intro band (with a search field instead of a statement), Shopify's sort options, the OHF product card grid
  and page numbers. Pages and blog posts that match appear as simple text tiles in the same grid.
  Shopify does the searching, sorting and paging; the field submits a normal search (/search?q=…).
  Styles and the sort script are shared with the Shop page: assets/ohf-shop.css and assets/ohf-shop.js.
{%- endcomment -%}
{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign has_terms = false
  if search.performed and search.terms != blank
    assign has_terms = true
  endif
-%}
{{ 'ohf-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ohf-shop.js' | asset_url }}" defer="defer"></script>

<section class="ohf-shop ohf-results" aria-labelledby="OhfResultsTitle-{{ section.id }}">
  <header class="ohf-shop__intro">
    <div class="ohf-wrap ohf-shop__intro-in">
      <p class="ohf-shop__kicker">{{ section.settings.kicker | escape }}</p>
      <h1 id="OhfResultsTitle-{{ section.id }}" class="ohf-shop__lede">
        {%- if has_terms -%}
          {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}
        {%- else -%}
          {{ section.settings.heading | escape }}
        {%- endif -%}
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="ohf-results__form">
        <label class="visually-hidden" for="OhfResultsInput-{{ section.id }}">{{ 'general.search.search' | t }}</label>
        <input
          class="ohf-results__input"
          id="OhfResultsInput-{{ section.id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ section.settings.placeholder | escape }}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <input name="options[prefix]" type="hidden" value="last">
        <button class="ohf-results__submit" type="submit" aria-label="{{ 'general.search.search' | t }}">
          {%- render 'ohf-icon', icon: 'search', size: 22 -%}
        </button>
      </form>
    </div>
  </header>

  <div class="ohf-wrap">
    {%- if has_terms -%}
      {%- if search.results_count > 0 -%}
        <div class="ohf-shop__bar">
          <p class="ohf-results__count" role="status">
            {{ 'templates.search.results_with_count' | t: count: search.results_count }}
          </p>
          {%- if search.sort_options.size > 1 -%}
            <label class="ohf-shop__sort">
              <span>{{ 'products.facets.sort_by_label' | t | remove: ':' }}</span>
              <select data-ohf-sort>
                {%- for option in search.sort_options -%}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>
                    {{- option.name | escape -}}
                  </option>
                {%- endfor -%}
              </select>
            </label>
          {%- endif -%}
        </div>

        {%- paginate search.results by section.settings.per_page -%}
          <h2 class="visually-hidden">{{ 'templates.search.title' | t }}</h2>
          <ul class="ohf-shop__grid" role="list">
            {%- for item in search.results -%}
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  <li class="ohf-shop__tile">
                    {%- render 'card-product',
                      card_product: item,
                      show_secondary_image: true,
                      lazy_load: true,
                      quick_add: 'none',
                      section_id: section.id,
                      skip_styles: true
                    -%}
                  </li>
                {%- when 'article' or 'page' -%}
                  <li class="ohf-shop__tile">
                    <a class="ohf-results__text" href="{{ item.url }}">
                      <span class="ohf-results__type">
                        {%- if item.object_type == 'article' -%}
                          {{ item.blog.title | escape }}
                        {%- else -%}
                          {{ 'templates.search.page' | t }}
                        {%- endif -%}
                      </span>
                      <span class="ohf-results__title">{{ item.title | escape }}</span>
                      {%- assign excerpt = item.excerpt_or_content | default: item.content | strip_html | truncatewords: 26 -%}
                      {%- if excerpt != blank -%}
                        <span class="ohf-results__excerpt">{{ excerpt }}</span>
                      {%- endif -%}
                      <span class="ohf-results__more">
                        {{- section.settings.read_label | escape -}}
                        {% render 'ohf-icon', icon: 'arrow-right', size: 18 -%}
                      </span>
                    </a>
                  </li>
              {%- endcase -%}
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            <nav class="ohf-shop__pages" aria-label="{{ 'general.pagination.label' | t }}">
              {%- if paginate.previous -%}
                <a class="ohf-shop__page" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">←</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a class="ohf-shop__page" href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="ohf-shop__page" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="ohf-shop__page ohf-shop__page--gap">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a class="ohf-shop__page" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">→</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="ohf-shop__empty" role="status">
          <p>{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
          <a class="ohf-cta ohf-cta--fill" href="{{ routes.all_products_collection_url }}">
            {{- section.settings.all_label | escape }}
            {% render 'ohf-icon', icon: 'arrow-right', size: 18 -%}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="ohf-shop__empty">
        <p>{{ section.settings.start_text | escape }}</p>
        <a class="ohf-cta ohf-cta--fill" href="{{ routes.all_products_collection_url }}">
          {{- section.settings.all_label | escape }}
          {% render 'ohf-icon', icon: 'arrow-right', size: 18 -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .ohf-results__form {
    position: relative;
    max-width: 560px;
    margin-top: var(--s24);
  }
  .ohf-results__input {
    width: 100%;
    height: 56px;
    padding: 0 60px 0 var(--s20);
    border: 1px solid transparent;
    border-radius: var(--r-xs);
    background: var(--ohf-light-grey);
    color: var(--ohf-dark-blue);
    font-family: var(--font-heading-family);
    font-size: 1.7rem;
    -webkit-appearance: none;
    appearance: none;
  }
  .ohf-results__input::placeholder {
    color: var(--ohf-dark-grey);
  }
  .ohf-results__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .ohf-results__input:focus-visible {
    outline: 3px solid var(--cta-focus);
    outline-offset: 2px;
  }
  .ohf-results__submit {
    position: absolute;
    top: 6px;
    right: 6px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--r-xs);
    background: var(--ohf-light-blue);
    color: var(--ohf-dark-blue);
    cursor: pointer;
    transition: background-color var(--dur-ui) var(--ease);
  }
  .ohf-results__submit:hover {
    background: var(--cta-hover);
  }
  .ohf-results__submit:focus-visible {
    outline: 3px solid var(--cta-focus);
    outline-offset: 2px;
  }
  .ohf-results__count {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    color: var(--body);
  }

  /* Pages and blog posts: text tiles the same size as a card */
  .ohf-results__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s12);
    padding: var(--s24);
    border-radius: var(--r-xs);
    background: #fff;
    color: var(--body);
    text-decoration: none;
    transition: background-color var(--dur-ui) var(--ease);
  }
  /* Same surfaces as the OHF product card (assets/ohf-card.css) */
  .ohf-results__text:hover {
    background: color-mix(in srgb, var(--cta-hover) 45%, #fff);
  }
  :root[data-lights='off'] .ohf-results__text {
    background: color-mix(in srgb, var(--ohf-light-grey) 6%, var(--bg));
  }
  :root[data-lights='off'] .ohf-results__text:hover {
    background: color-mix(in srgb, var(--ohf-light-grey) 12%, var(--bg));
  }
  .ohf-results__text:focus-visible {
    outline: 3px solid var(--cta-focus);
    outline-offset: 2px;
  }
  .ohf-results__type {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ohf-results__title {
    font-family: var(--font-heading-family);
    font-weight: 500;
    font-size: 2.4rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--heading);
  }
  .ohf-results__excerpt {
    font-size: 1.5rem;
    line-height: 1.5;
  }
  .ohf-results__more {
    display: inline-flex;
    align-items: center;
    gap: var(--s6);
    margin-top: auto;
    padding-top: var(--s12);
    border-top: 1px solid var(--line);
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 1.4rem;
    color: var(--heading);
  }
  @media (max-width: 1100px) {
    .ohf-results .ohf-shop__sort {
      grid-row: auto;
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "OHF search results",
  "class": "ohf-results-section",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small heading",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading before a search",
      "default": "What are you looking for?"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search field placeholder",
      "default": "Hoodies, stickers, ESPHome…"
    },
    {
      "type": "text",
      "id": "start_text",
      "label": "Text before a search",
      "default": "Search for a product, a project or a page. Or browse everything we make."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Shop all button",
      "default": "Shop all"
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Link on page results",
      "default": "Read more"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Results per page",
      "min": 6,
      "max": 24,
      "step": 6,
      "default": 12
    }
  ]
}
{% endschema %}

{%- comment -%}
  Words for the OHF manifesto fill (sections/ohf-manifesto.liquid): each word stays on one line and each letter
  is its own span, so the letters can light up one by one as the page scrolls.
  Usage: {% render 'ohf-fill-words', text: 'Some words' %}
{%- endcomment -%}
{%- assign fill_words = text | strip | split: ' ' -%}
{%- for word in fill_words -%}
  <span class="ohf-fill__word">
    {%- assign fill_chars = word | split: '' -%}
    {%- for ch in fill_chars -%}
      <span class="ohf-fill__ch">{{ ch | escape }}</span>
    {%- endfor -%}
  </span>
  {%- unless forloop.last -%}{{ ' ' }}{%- endunless -%}
{%- endfor -%}
